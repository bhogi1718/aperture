# Postgres
DATABASE_URL=postgresql://aperture:aperture_dev_password@localhost:5432/aperture

# Auth (reviewer dashboard)
JWT_SECRET=replace-with-a-long-random-string-before-any-real-deployment
REVIEWER_USERNAME=reviewer
# Generate with: npm run hash:reviewer-password --workspace=backend -- <password>
REVIEWER_PASSWORD_HASH=

# Auth (applicant sessions, issued after OTP verification) -- keep this
# different from JWT_SECRET so reviewer and applicant tokens are never
# interchangeable
APPLICANT_JWT_SECRET=replace-with-a-different-long-random-string

# Email OTP provider: "mock" (default, logs code to console + dev-only API
# response, no external account needed) or "smtp"
EMAIL_OTP_PROVIDER=mock

# Only required when EMAIL_OTP_PROVIDER=smtp. Works with any SMTP provider --
# Gmail (with an app password), Resend, SendGrid, Mailgun, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# LLM provider: "mock" (default, no external calls) or "bedrock"
LLM_PROVIDER=mock

# Only required when LLM_PROVIDER=bedrock
AWS_REGION=ap-south-1
BEDROCK_EXPLANATION_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Model service
MODEL_SERVICE_URL=http://localhost:8000

# Server
PORT=4000
